# --- Database ---
# PostgreSQL connection string. Point this at your own Postgres instance:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tile_shop?schema=public"
# Or, to try the project without installing Postgres, run `npm run db:dev` (see README)
# and use its local PGlite-backed server instead:
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:55432/postgres?sslmode=disable&connection_limit=1"

# --- NextAuth ---
# Generate a secret with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- Zarinpal Payment Gateway ---
# Merchant ID from https://next.zarinpal.com (sandbox merchant id for testing: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx)
ZARINPAL_MERCHANT_ID="00000000-0000-0000-0000-000000000000"
# Set to "true" while developing against the Zarinpal sandbox
ZARINPAL_SANDBOX="true"

# Public site URL, used to build Zarinpal callback URL
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# --- File uploads (product images) ---
# Local folder (relative to project root) where uploaded product images are stored
UPLOAD_DIR="public/uploads"

# --- AI chat assistant ---
# Get a key from https://console.anthropic.com (API Keys). Without this, the
# support chat widget still works but every conversation goes straight to a
# human admin instead of getting an automatic AI reply first.
ANTHROPIC_API_KEY=""
